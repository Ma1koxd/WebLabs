# Только пример для локальной лабораторной работы.
POSTGRES_DB=library
POSTGRES_USER=library
POSTGRES_PASSWORD=change_library_password

# Адрес для запуска Python непосредственно на компьютере.
# В Docker Compose адрес заменяется на адрес контейнера db.
DATABASE_URL=postgresql+psycopg://library:change_library_password@127.0.0.1:5432/library

# Замените на случайную строку длиной не меньше 32 символов.
JWT_SECRET=replace_this_development_secret_with_random_64_hex_characters

# Пользователь создаётся seed-скриптом только при первом запуске.
SEED_USERNAME=student
SEED_PASSWORD=student12345
